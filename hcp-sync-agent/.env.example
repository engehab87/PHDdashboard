# =============================================================================
# HCP Sync Agent — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# --- HCP Server (Hikvision HikCentral Professional) ---
# Base URL: https://<host>:<port>/artemis/api
HCP_HOST=192.168.15.15
HCP_PORT=443
HCP_HTTPS=1
HCP_TLS_VERIFY=1
# Optional pinned CA (PEM). Required if the server cert is self-signed / private CA.
# Multi-line PEM supported via literal newlines or \n escaping.
HCP_TLS_CA=
HCP_READ_TIMEOUT_MS=15000

# OpenAPI application credentials (stored in plaintext in .env — restrict file perms)
HCP_APP_KEY=your_app_key_here
HCP_APP_SECRET=your_app_secret_here

# Camera index code — REQUIRED for crossRecords/page (vehicle access events)
HCP_CAMERA_INDEX_CODE=1

# --- Sync window ---
# How far back (days) to fetch on each incremental sync run.
# The HCP API enforces a 31-day max window per request.
HCP_SYNC_LOOKBACK_DAYS=30

# --- Cloud Database (PostgreSQL) ---
# Example: postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://syncuser:syncpass@cloud-db.example.com:5432/hcp_sync

# --- Agent behaviour ---
SYNC_INTERVAL_MS=300000          # 5 minutes between automatic sync runs (0 = manual only)
SYNC_ENABLED_CATEGORIES=persons,vehicles,access-events,visitors
LOG_LEVEL=info                   # info|debug|error
LOG_FORMAT=text                  # text|json
