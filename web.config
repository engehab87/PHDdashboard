<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="node" arguments=".\server.js" startupTimeLimit="30" stdoutLogEnabled="true" stdoutLogFile=".\logs\node">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="DB_PATH" value=".\data\app.db" />
        <environmentVariable name="HCP_HEALTHCHECK_MS" value="0" />
        <environmentVariable name="FORTICLIENT_ENABLED" value="false" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
