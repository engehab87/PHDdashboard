# ---------------------------------------------------------------------------
# Palm Hills HCP Dashboard — Environment template
# Copy to .env and fill in values (or run setup-dashboard.ps1 / setup-dashboard.js)
# ---------------------------------------------------------------------------

# REQUIRED: 64-hex AES-256-GCM key for encrypting app_secret / vpn_password
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this key orphans previously stored secrets — you must re-enter them.
HCP_VAULT_KEY=

# Backend
PORT=2020
DB_PATH=data/app.db

# FortiClient VPN control
# Leave ENABLED=false for the first runs and connect the tunnel manually in the GUI.
# Only set true after you have verified the CLI path and tunnel name.
FORTICLIENT_ENABLED=false
FORTICLIENT_CLI=C:\Program Files\Fortinet\FortiClient\forticli.exe
FORTICLIENT_TUNNEL=PHNC-Tunnel

# Health-check interval in milliseconds (0 = disabled)
HCP_HEALTHCHECK_MS=300000
